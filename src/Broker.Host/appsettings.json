{
  "Pipe": {
    "Name": "McpBroker",
    "MaxInstances": 8,
    "FrameTimeoutSeconds": 5,
    "AllowedSids": [
      "S-1-5-21-0000000000-0000000000-0000000000-1001"
    ]
  },
  "Manifest": {
    "Path": "policy/manifest.json",
    "RequireIntegrity": true,
    "IntegrityPath": "policy/manifest.json.sha256"
  },
  "Jea": {
    "TranscriptDir": "C:\\McpBroker\\Transcripts",
    "OpenTimeoutMs": 30000,
    "OperationTimeoutMs": 60000,
    "Limits": {
      "MaxConcurrentTotal": 8,
      "MaxConcurrentPerEndpoint": 4,
      "MaxConcurrentPerTool": 2,
      "MaxQueueLength": 16,
      "QueueWaitSeconds": 5,
      "ExecutionTimeoutSeconds": 60,
      "MaxResponseBytes": 524288
    }
  },
  "Elicitation": {
    "TtlSeconds": 120,
    "RequireDistinctApprover": true,
    "ApproverSids": [],
    "ApprovalPipeName": "McpBroker.Approvals",
    "ApprovalPipeInstances": 4
  },
  "Taint": {
    "WindowSeconds": 300
  },
  "Audit": {
    "CorrelationLogPath": "C:\\McpBroker\\correlation.log"
  },
  "RateLimit": {
    "CallsPerMinute": 60,
    "DestructivePerHour": 10,
    "GlobalCallsPerMinute": 600
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Warning"
      }
    }
  },
  "Amsi": {
    "Mode": "BestEffort"
  }
}
