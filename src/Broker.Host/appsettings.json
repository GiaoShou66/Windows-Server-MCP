{
  "Pipe": {
    "Name": "McpBroker",
    "MaxInstances": 8,
    "FrameTimeoutSeconds": 5,
    "AllowedSids": [
      "S-1-5-21-0000000000-0000000000-0000000000-1001"
    ]
  },
  "Manifest": {
    "Path": "policy/manifest.json"
  },
  "Jea": {
    "TranscriptDir": "C:\\McpBroker\\Transcripts"
  },
  "Elicitation": {
    "TtlSeconds": 120,
    "RequireDistinctApprover": false,
    "ApproverSids": [],
    "ApprovalPipeName": "McpBroker.Approvals",
    "ApprovalPipeInstances": 4
  },
  "Taint": {
    "WindowSeconds": 300
  },
  "Audit": {
    "CorrelationLogPath": "C:\\McpBroker\\correlation.log"
  },
  "RateLimit": {
    "CallsPerMinute": 60,
    "DestructivePerHour": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Warning"
      }
    }
  }
}
